<UserControl x:Class="ProjectEcho.App.SeekPlaybackIcon" x:Name="IconRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False" Focusable="False">
 <Viewbox Stretch="Uniform">
  <Grid Width="28" Height="28">
   <Grid x:Name="Arrow" RenderTransformOrigin="0.5,0.5">
    <Path Data="M 21.794228634 9.5 A 9 9 0 1 1 14 5" Stroke="{Binding Foreground, ElementName=IconRoot}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Path Data="M 12 1 L 18 5 L 12 9 Z" Fill="{Binding Foreground, ElementName=IconRoot}"/>
   </Grid>
   <Path x:Name="NumberGlyph" Fill="{Binding Foreground, ElementName=IconRoot}"/>
  </Grid>
 </Viewbox>
</UserControl>
