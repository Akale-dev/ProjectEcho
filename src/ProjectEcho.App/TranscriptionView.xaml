<UserControl x:Class="ProjectEcho.App.TranscriptionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock x:Name="MeetingText" Text="先在会议库选择一场已保存录音。" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TabControl x:Name="WorkspaceTabs" Padding="16">
   <TabItem Header="导入文字">
    <StackPanel Margin="0,12,0,0">
     <TextBlock Text="将外部转写结果带回这场会议" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="支持 TXT、Markdown、SRT、VTT 和 ProjectEcho JSON。纯文本保留为无时间文字；原稿和每次校订分别保存。" Margin="0,6,0,16"/>
     <WrapPanel><Button x:Name="ImportFileButton" Content="选择转写文件…"/><TextBlock x:Name="ImportFileText" Text="尚未选择" VerticalAlignment="Center" MaxWidth="540"/></WrapPanel>
     <TextBlock Text="来源名称（例如手动转写或服务名称）"/><TextBox x:Name="ProviderBox" Text="手动导入" MaxLength="100" Margin="0,4,0,12"/>
     <Expander Header="导入的是导出分片：设置时间映射" Margin="0,0,0,12">
      <StackPanel Margin="0,12,0,0">
       <TextBlock Text="选择该场已生成混音对应的 export-manifest.json 或本地导出记录，再填写分片文件名。字幕从该分片的 0 秒开始计时；导入时校验所属混音。"/>
       <WrapPanel><Button x:Name="MappingFileButton" Content="选择映射清单…"/><Button x:Name="ClearMappingButton" Content="清除映射"/></WrapPanel>
       <TextBlock x:Name="MappingFileText" Text="未使用分片映射：字幕按完整会议时间导入。"/>
       <TextBlock Text="分片文件名（例：part-0001.mp3）" Margin="0,8,0,0"/><TextBox x:Name="PartBox" MaxLength="200"/>
      </StackPanel>
     </Expander>
     <Button x:Name="ImportButton" Content="导入到当前会议" HorizontalAlignment="Left"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="搜索与校订">
    <StackPanel Margin="0,12,0,0">
     <WrapPanel><Button x:Name="RefreshButton" Content="读取转写版本"/><TextBlock Text="选择要查看的版本" VerticalAlignment="Center"/></WrapPanel>
     <ComboBox x:Name="RevisionBox" DisplayMemberPath="Label"/>
     <DockPanel Margin="0,6,0,6"><Button x:Name="SearchButton" Content="搜索" DockPanel.Dock="Right"/><TextBox x:Name="SearchBox" ToolTip="输入关键词；搜索只在本地进行"/></DockPanel>
     <CheckBox x:Name="AllMeetingsBox" Content="搜索当前数据目录的所有会议（点击搜索时读取）" Margin="0,0,0,8"/>
     <ListBox x:Name="SegmentsBox" Height="205" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="SegmentTimeText" Text="选择一条文字可校订；有时间戳时可定位回放。" Margin="0,8,0,6"/>
     <TextBox x:Name="EditBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" MaxLength="100000"/>
     <WrapPanel Margin="0,10,0,0"><Button x:Name="SaveRevisionButton" Content="保存为新修订"/><Button x:Name="SeekButton" Content="从此处回听"/><Button x:Name="StopListeningButton" Content="停止回听"/></WrapPanel>
     <TextBlock Text="重叠内容只提示复核，保留各片原文。人物标签不等于已确认身份。录音和暂停期间不可回听。"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="本地识别（可选）">
    <StackPanel Margin="0,12,0,0">
     <TextBlock Text="在本机运行 whisper.cpp" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="选择自己准备好的 CLI 和模型。无需账号或 API；未配置时仍可正常录音、导出与导入文字。" Margin="0,6,0,14"/>
     <WrapPanel><Button x:Name="WhisperExeButton" Content="选择 whisper-cli.exe…"/><TextBlock x:Name="WhisperExeText" Text="未配置程序" VerticalAlignment="Center" MaxWidth="500"/></WrapPanel>
     <WrapPanel><Button x:Name="WhisperModelButton" Content="选择本地模型…"/><TextBlock x:Name="WhisperModelText" Text="未配置模型" VerticalAlignment="Center" MaxWidth="500"/></WrapPanel>
     <TextBlock Text="模型 SHA-256（可选，用于与可信来源公布的值比对）"/><TextBox x:Name="ModelHashBox" MaxLength="64" Margin="0,4,0,10"/>
     <CheckBox x:Name="ModelLicenseBox" Content="我已核对该程序和模型来源可信，并确认模型许可允许本次本地使用。" Margin="0,0,0,12"/>
     <WrapPanel><TextBlock Text="语言 " VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Width="150" SelectedIndex="0"><ComboBoxItem Content="自动" Tag="auto"/><ComboBoxItem Content="中文" Tag="zh"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></WrapPanel>
     <WrapPanel><Button x:Name="SaveConfigurationButton" Content="保存本机配置"/><Button x:Name="RunWhisperButton" Content="开始 / 重试本地识别"/></WrapPanel>
     <TextBlock Text="识别使用完整混音的会后副本；每次尝试单独保存输出和耗时。识别结果需校对，尚无本机准确率或速度承诺。"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <WrapPanel Margin="0,12,0,0"><Button x:Name="CancelButton" Content="取消文字任务" IsEnabled="False"/></WrapPanel>
  <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="65" MaxHeight="160" Text="尚未读取转写。所有内容仅在本地处理。"/>
 </StackPanel>
</UserControl>
