<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <InformationalVersion>M3O-Lite-20261006</InformationalVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProjectEcho</AssemblyName>
    <ApplicationIcon>Assets/ProjectEcho.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="ProjectEcho.Localization.%(Filename)%(Extension)" />
    <Resource Include="Assets/ProjectEcho.ico" />
    <Resource Include="Assets/ProjectEcho.png" />
    <Resource Include="Assets/MicOn-M3H.png" />
    <Resource Include="Assets/MicOff-M3H.png" />
    <ProjectReference Include="../ProjectEcho.Core/ProjectEcho.Core.csproj" />
    <ProjectReference Include="../ProjectEcho.Capture.Windows/ProjectEcho.Capture.Windows.csproj" />
    <ProjectReference Include="../ProjectEcho.Export/ProjectEcho.Export.csproj" />
    <ProjectReference Include="../ProjectEcho.CaptureHost/ProjectEcho.CaptureHost.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../ProjectEcho.CaptureHost/HostProtocol.cs" Link="HostProtocol.cs" />
  </ItemGroup>
  <Target Name="CopyCaptureHost" AfterTargets="Build">
    <ItemGroup>
      <HostFiles Include="../ProjectEcho.CaptureHost/bin/$(Configuration)/$(TargetFramework)/*" Exclude="../ProjectEcho.CaptureHost/bin/$(Configuration)/$(TargetFramework)/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(OutDir)CaptureHost" SkipUnchangedFiles="true" />
  </Target>
</Project>
