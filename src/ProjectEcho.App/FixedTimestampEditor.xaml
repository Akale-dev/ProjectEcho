<UserControl x:Class="ProjectEcho.App.FixedTimestampEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Editor" Width="118" MinHeight="34" Focusable="False"
 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
 PreviewKeyDown="Editor_PreviewKeyDown">
 <UserControl.Resources>
  <Style x:Key="TimestampDigitField" TargetType="TextBox">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
   <Setter Property="FontFamily" Value="Consolas"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="AllowDrop" Value="False"/>
   <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="TimestampSeparator" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Border BorderBrush="{Binding BorderBrush, ElementName=Editor}" BorderThickness="{Binding BorderThickness, ElementName=Editor}"
         Background="{Binding Background, ElementName=Editor}" CornerRadius="4" Padding="2,0">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
   <Grid x:Name="DigitFields" KeyboardNavigation.TabNavigation="Local">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="22"/><ColumnDefinition Width="7"/><ColumnDefinition Width="15"/><ColumnDefinition Width="7"/>
     <ColumnDefinition Width="15"/><ColumnDefinition Width="7"/><ColumnDefinition Width="15"/>
    </Grid.ColumnDefinitions>
    <TextBox x:Name="HoursBox" Style="{StaticResource TimestampDigitField}" MaxLength="3" TabIndex="0"/>
    <TextBlock x:Name="HoursSeparator" Grid.Column="1" Text=":" Style="{StaticResource TimestampSeparator}"/>
    <TextBox x:Name="MinutesBox" Grid.Column="2" Style="{StaticResource TimestampDigitField}" MaxLength="2" TabIndex="1"/>
    <TextBlock x:Name="MinutesSeparator" Grid.Column="3" Text=":" Style="{StaticResource TimestampSeparator}"/>
    <TextBox x:Name="SecondsBox" Grid.Column="4" Style="{StaticResource TimestampDigitField}" MaxLength="2" TabIndex="2"/>
    <TextBlock x:Name="FractionSeparator" Grid.Column="5" Text="." Style="{StaticResource TimestampSeparator}"/>
    <TextBox x:Name="CentisecondsBox" Grid.Column="6" Style="{StaticResource TimestampDigitField}" MaxLength="2" TabIndex="3"/>
   </Grid>
   <TextBlock x:Name="RawInputText" Visibility="Collapsed" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
   <Button x:Name="ClearButton" Grid.Column="1" Content="×" FontSize="12" Margin="0" Padding="0"
           MinHeight="28" Height="28" MinWidth="0" BorderThickness="0" Background="Transparent" TabIndex="4" Click="ClearButton_Click"/>
  </Grid>
 </Border>
</UserControl>
