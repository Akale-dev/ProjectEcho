<Window x:Class="ProjectEcho.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectEcho · 本地会议录音" Icon="Assets/ProjectEcho.ico" Width="1220" Height="930" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="24,28,18,24">
          <Image Source="Assets/ProjectEcho.png" RenderOptions.BitmapScalingMode="HighQuality" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,13"/>
          <TextBlock Text="ProjectEcho" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="20"/>
          <TextBlock Text="留住讨论，接续思考" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,16,16,20">
          <Button Content="切换明暗主题" Click="ToggleTheme_Click" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" BorderBrush="#45626D" FontSize="11" Padding="8,6"/>
          <TextBlock Text="本地保存 · 手动上传" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Margin="2,7,0,0"/>
          <TextBlock Text="验证版 · 部分现场验收待完成" Foreground="{DynamicResource SidebarTextBrush}" FontSize="10" Margin="2,7,0,0"/>
        </StackPanel>
        <ListBox x:Name="NavigationList" SelectedIndex="0" SelectionChanged="Navigation_SelectionChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="功能导航">
          <ListBoxItem Content="01   录音"/>
          <ListBoxItem Content="02   会议库"/>
          <ListBoxItem Content="03   导出音频"/>
          <ListBoxItem Content="04   转写与搜索"/>
          <ListBoxItem Content="05   诊断与设置"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,18,26,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="本场录制范围" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5"/>
            <TextBlock x:Name="ScopeText" FontSize="12" FontWeight="Medium" LineHeight="20" AutomationProperties.Name="当前音频来源及麦克风状态"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14,9" Margin="22,0,0,0" VerticalAlignment="Top" MaxWidth="245">
            <TextBlock x:Name="SessionStateText" FontSize="14" FontWeight="SemiBold" Text="尚未录音"/>
          </Border>
        </Grid>
      </Border>
      <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" BorderThickness="0" Background="Transparent">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="录音">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12">
            <StackPanel>
              <TextBlock Text="专注当下，完整记录" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="确认会议声音来自哪里，再决定是否录下自己的麦克风。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><Label Target="{Binding ElementName=TitleBox}" Content="会议标题" Padding="0,0,0,6" Foreground="{DynamicResource TextBrush}"/><TextBox x:Name="TitleBox" ToolTip="留空时按当前日期时间命名"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="项目" Margin="0,0,0,6"/><TextBox Text="未分类" IsReadOnly="True" IsTabStop="False"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel x:Name="SelectionPanel">
                  <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新来源" Click="Refresh_Click" Margin="12,0,0,0"/><TextBlock Text="声音来源" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/></DockPanel>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="录制模式" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="ModeBox" SelectionChanged="Selection_Changed" SelectedIndex="0" AutomationProperties.Name="录制模式"><ComboBoxItem Content="会议进程树 · 选定应用及其子进程"/><ComboBoxItem Content="端点兼容 · 输出设备上的所有应用声音"/></ComboBox>
                  <TextBlock Text="实际音频会话 / 候选进程树" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="SourceBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="本次音频来源"/>
                  <TextBlock Text="浏览器范围包含选定进程树的所有有声标签页，不能据此保证单标签隔离。" Style="{StaticResource MutedText}" FontSize="11"/>
                  <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ModeBox}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="输出端点" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EndpointBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="端点兼容输出设备"/>
                    <CheckBox x:Name="EndpointConsent" Checked="Selection_Changed" Unchecked="Selection_Changed"><TextBlock Text="我确认：会录入此设备上其他应用和通知声音"/></CheckBox>
                  </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Margin="0,10,0,0" Padding="22,0,0,0">
                    <StackPanel>
                      <TextBlock Text="独立麦克风" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                      <CheckBox x:Name="MicEnabled" FontWeight="SemiBold" Checked="Mic_Checked" Unchecked="Selection_Changed"><TextBlock Text="本场明确开启麦克风 · 默认关闭"/></CheckBox>
                      <ComboBox x:Name="MicBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="本场固定麦克风设备"/>
                      <TextBlock Text="与 Zoom / Webex 静音独立。仅选择设备不会采集；设备缺失时不会自动更换。建议使用耳机。" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                  </Border>
                  </Grid>
                  <Expander Header="专用浏览器与试录提示">
                    <StackPanel Margin="0,12,0,0">
                      <Button Content="打开专用 Chrome 合成音页" Click="Browser_Click" HorizontalAlignment="Left"/>
                      <TextBlock Text="专用实例使用独立 user-data-dir。启动 PID 只是候选，仍需刷新并选择真实音频会话。首次使用或来源变化时，建议主动做一次 10 秒试录。" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="录音健康" Style="{StaticResource SectionTitle}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="远端 / 应用" VerticalAlignment="Center"/><ProgressBar x:Name="RemoteLevel" Grid.Column="1" Height="8" Maximum="1"/><TextBlock x:Name="RemoteHealth" Grid.Column="2" Margin="16,0,0,0" Text="尚未采集" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="独立麦克风" VerticalAlignment="Center" Margin="0,16,0,0"/><ProgressBar x:Name="MicLevel" Grid.Row="1" Grid.Column="1" Height="8" Maximum="1" Margin="0,16,0,0"/><TextBlock x:Name="MicHealth" Grid.Row="1" Grid.Column="2" Margin="16,16,0,0" Text="关闭 · 不采集" FontSize="12"/>
                  </Grid>
                  <TextBlock x:Name="ConnectionText" Margin="0,18,0,5" Text="捕获连接：未启动" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="StorageText" Text="保存状态：尚未创建本次录音" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="会议库">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="每一场讨论，都有原件" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="选择已保存的会议，回听、整理标题，或检查中断后可恢复的内容。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <StackPanel x:Name="RecoveryPanel">
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="本地会议" Style="{StaticResource SectionTitle}"/>
                <WrapPanel><Button Content="读取会议列表" Click="RefreshRecovery_Click"/><Button Content="打开原件目录" Click="OpenRecordingFolder_Click"/></WrapPanel>
                <TextBlock Text="点击后读取当前数据目录；原始音轨始终保留。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,12"/>
                <ComboBox x:Name="RecoveryBox" DisplayMemberPath="Name" SelectionChanged="RecoverySelection_Changed" AutomationProperties.Name="本地已保存会议"/>
                <Expander Header="整理会议标题与项目"><StackPanel Margin="0,6,0,0">
                <TextBlock Text="标题" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FiledTitleBox"/>
                <TextBlock Text="项目" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FiledProjectBox" Text="未分类"/>
                <Button x:Name="FileMeetingButton" Content="保存归档信息" Click="FileMeeting_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel></Expander>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Expander Header="检查与恢复原件" Margin="0"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="只检查所选的一场。恢复创建新副本，不覆盖原件，也不代表缺失的录音已经找回。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <WrapPanel><Button x:Name="InspectRecoveryButton" Content="检查所选录音" Click="InspectRecovery_Click" IsEnabled="False"/><Button x:Name="RecoverButton" Content="创建恢复副本" Click="Recover_Click" IsEnabled="False"/></WrapPanel>
                </StackPanel></Expander>
              </StackPanel></Border>
            </StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="回听完整录音" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Text, ElementName=SelectedMeetingText}" FontWeight="Medium" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="PlaybackButton" Content="播放完整录音" Click="Playback_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button x:Name="StopPlaybackButton" Content="停止回放" Click="StopPlayback_Click"/><Button Content="前往导出" Tag="2" Click="Navigate_Click"/></WrapPanel>
              <TextBlock Text="录音期间（包括暂停及保存收尾）禁用本程序回放。" Style="{StaticResource MutedText}" FontSize="11"/>
            </StackPanel></Border>
            <TextBox x:Name="RecoveryStatus" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="85" MaxHeight="180" Text="尚未读取任何历史录音。"/>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="导出音频">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="一份完整、可带走的声音" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="从独立原轨生成真正的混音，再按接收服务的大小要求导出。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="当前会议" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="SelectedMeetingText" Text="尚未选择已保存的普通录音。" FontWeight="Medium" Margin="0,0,0,14"/>
              <WrapPanel><Button Content="选择会议" Tag="1" Click="Navigate_Click"/><Button x:Name="RetryMixButton" Content="生成 / 重试完整混音" Click="RetryMix_Click" IsEnabled="False"/><Button x:Name="CancelExportButton" Content="取消混音 / 导出" Click="CancelExport_Click" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="完整时间轴保留暂停与缺口；导出任务独立运行，不阻挡下一场录音。" Style="{StaticResource MutedText}" FontSize="11"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="导出副本" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="音频格式" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
              <ComboBox x:Name="ExportFormatBox" HorizontalAlignment="Left" Width="330" SelectedIndex="0" AutomationProperties.Name="导出音频格式"><ComboBoxItem Content="M4A · 压缩音频"/><ComboBoxItem Content="WAV · 无损音频"/><ComboBoxItem Content="MP3 · 压缩音频"/></ComboBox>
              <Expander Header="分段与大小设置" IsExpanded="False"><StackPanel Margin="0,12,0,4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0"><TextBlock Text="每片最多字节" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxBytesBox" Text="20000000"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="每片最多秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxSecondsBox" Text="1800"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="相邻片重叠秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OverlapBox" Text="5"/></StackPanel>
                </Grid>
                <TextBlock Text="默认预算为 20 MB / 30 分钟，重叠 5 秒；请按接收服务要求调整。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel></Expander>
              <CheckBox x:Name="IncludeManifestBox" Margin="0,15,0,15"><TextBlock Text="另附分段时间映射清单（文件名、哈希与时间）"/></CheckBox>
              <WrapPanel><Button x:Name="ExportButton" Content="导出供转写" Click="Export_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button x:Name="OpenExportButton" Content="打开导出目录" Click="OpenExport_Click" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="只导出所选混音副本。不附原始麦克风轨、浏览器资料或诊断日志；上传由你自行操作。" Style="{StaticResource MutedText}" FontSize="11"/>
            </StackPanel></Border>
            <TextBlock Text="处理结果" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="ExportStatus" IsReadOnly="True" TextWrapping="Wrap" MinHeight="125" MaxHeight="230" VerticalScrollBarVisibility="Auto" Text="录音保存后会自动生成完整混音。也可以在会议库选择历史录音后重试。"/>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="转写与搜索">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="让讨论可以被找回" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="导入已有文本，或使用本地工具进行会后转写。录音不依赖模型。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <ContentControl x:Name="TranscriptionContent" HorizontalContentAlignment="Stretch"/>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="诊断与设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="状态清楚，原件可追溯" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="查看预检结果与环境信息，选择本地保存位置。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="保存位置" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="DataRootText" Margin="0,0,0,14" FontFamily="Consolas"/>
              <Button x:Name="DataRootButton" Content="选择数据目录" Click="DataRoot_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="原轨、浏览器资料和导出分别存放于此目录内。最长单场录音为 8 小时。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="环境与验证范围" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="EnvironmentText" Style="{StaticResource MutedText}"/>
              <TextBlock Text="部分平台、双设备长期同步及干净 Windows 验收尚未完成。首次使用或更换来源后，请先做可控试录。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="最近诊断信息" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" MaxHeight="380" Text="尚未采集。请选择本次音频来源，预检后主动开始录音。"/>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,12,18,12">
        <StackPanel>
          <WrapPanel>
            <Button x:Name="StartButton" Content="开始录音" Click="Start_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="停止并保存" Click="Stop_Click" IsEnabled="False" Style="{StaticResource StopButtonStyle}"/>
            <Button x:Name="MicControlButton" Content="开启 mic" Click="MicControl_Click" IsEnabled="False"/>
            <Button x:Name="BookmarkButton" Content="标记此刻" Click="Bookmark_Click" IsEnabled="False"/>
            <Button x:Name="PreflightButton" Content="预检" Click="Preflight_Click" ToolTip="静态检查，不采集音频"/>
            <Button x:Name="TrialButton" Content="10 秒试录" Click="Trial_Click"/>
          </WrapPanel>
          <DockPanel Margin="2,4,0,0">
            <Button DockPanel.Dock="Right" Content="查看详情" Tag="4" Click="Navigate_Click" FontSize="11" Padding="8,3" MinHeight="24" Margin="14,0,0,0"/>
            <TextBlock Text="{Binding Text, ElementName=StatusBox}" Foreground="{DynamicResource MutedBrush}" FontSize="11" MaxHeight="35" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
