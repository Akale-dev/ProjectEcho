<Window x:Class="ProjectEcho.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectEcho · 本地会议录音" Icon="Assets/ProjectEcho.ico" Width="1280" Height="930" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}">
      <DockPanel LastChildFill="True" Margin="14,0">
        <StackPanel DockPanel.Dock="Top" Margin="12,25,8,20">
          <Image Source="Assets/ProjectEcho.png" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10"/>
          <TextBlock Text="ProjectEcho" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="21"/>
          <TextBlock Text="留住讨论，接续思考" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,18">
          <Button x:Name="SettingsNavigationButton" Content="04   诊断与设置" Tag="4" Click="Navigate_Click" Style="{StaticResource SidebarButton}"/>
          <TextBlock Text="本地保存 · 手动上传" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Margin="13,8,0,0"/>
        </StackPanel>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="RecordNavigationButton" Content="01   新会议录音" Tag="0" Click="Navigate_Click" Style="{StaticResource SidebarButton}"/>
          <Button x:Name="LibraryNavigationButton" Grid.Row="1" Content="02   会议库   ▾" Click="LibraryNavigation_Click" Style="{StaticResource SidebarButton}"/>
          <Grid x:Name="LibraryListPanel" Grid.Row="2" Margin="0,4,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="10,0,4,6"><Button DockPanel.Dock="Right" Content="刷新" Click="RefreshRecovery_Click" Padding="8,3" MinHeight="25" FontSize="11"/><TextBlock x:Name="MeetingCountText" Text="点击会议库读取历史" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
            <ListBox x:Name="RecoveryBox" Grid.Row="1" SelectionChanged="RecoverySelection_Changed" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="历史会议日期和名称">
              <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DateLabel}" FontSize="10" Opacity="0.7" Margin="0,0,0,5"/><TextBlock Text="{Binding Name}" FontSize="12" MaxHeight="40" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Button x:Name="ImportAudioButton" Grid.Row="3" Content="03   导入录音" Click="ImportAudio_Click" Style="{StaticResource SidebarButton}" ToolTip="导入 WAV / MP3 / M4A，复制并保留原件"/>
        </Grid>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="PageContextText" Text="会议库" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,5"/><TextBlock x:Name="ScopeText" FontSize="11" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="当前音频来源及麦克风状态"/></StackPanel>
          <Button Grid.Column="1" Tag="0" Click="Navigate_Click" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="进入录音界面查看控制"><TextBlock x:Name="SessionStateText" Text="尚未录音" FontWeight="SemiBold"/></Button>
        </Grid>
      </Border>
      <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="1" BorderThickness="0" Background="Transparent">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="录音">

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12">
            <StackPanel>
              <TextBlock Text="专注当下，完整记录" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="确认会议声音来自哪里，再决定是否录下自己的麦克风。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><Label Target="{Binding ElementName=TitleBox}" Content="会议标题" Padding="0,0,0,6" Foreground="{DynamicResource TextBrush}"/><TextBox x:Name="TitleBox" ToolTip="留空时按当前日期时间命名"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="项目" Margin="0,0,0,6"/><TextBox Text="未分类" IsReadOnly="True" IsTabStop="False"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel x:Name="SelectionPanel">
                  <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新来源" Click="Refresh_Click" Margin="12,0,0,0"/><TextBlock Text="声音来源" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/></DockPanel>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="录制模式" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="ModeBox" SelectionChanged="Selection_Changed" SelectedIndex="0" AutomationProperties.Name="录制模式"><ComboBoxItem Content="会议进程树 · 选定应用及其子进程"/><ComboBoxItem Content="端点兼容 · 输出设备上的所有应用声音"/></ComboBox>
                  <TextBlock Text="实际音频会话 / 候选进程树" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="SourceBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="本次音频来源"/>
                  <TextBlock Text="浏览器范围包含选定进程树的所有有声标签页，不能据此保证单标签隔离。" Style="{StaticResource MutedText}" FontSize="11"/>
                  <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ModeBox}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="输出端点" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EndpointBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="端点兼容输出设备"/>
                    <CheckBox x:Name="EndpointConsent" Checked="Selection_Changed" Unchecked="Selection_Changed"><TextBlock Text="我确认：会录入此设备上其他应用和通知声音"/></CheckBox>
                  </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Margin="0,10,0,0" Padding="22,0,0,0">
                    <StackPanel>
                      <TextBlock Text="独立麦克风" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                      <CheckBox x:Name="MicEnabled" FontWeight="SemiBold" Checked="Mic_Checked" Unchecked="Selection_Changed"><TextBlock Text="本场明确开启麦克风 · 默认关闭"/></CheckBox>
                      <ComboBox x:Name="MicBox" SelectionChanged="Selection_Changed" AutomationProperties.Name="本场固定麦克风设备"/>
                      <TextBlock Text="与 Zoom / Webex 静音独立。仅选择设备不会采集；设备缺失时不会自动更换。建议使用耳机。" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                  </Border>
                  </Grid>
                  <Expander Header="专用浏览器与试录提示">
                    <StackPanel Margin="0,12,0,0">
                      <Button Content="打开专用 Chrome 合成音页" Click="Browser_Click" HorizontalAlignment="Left"/>
                      <TextBlock Text="专用实例使用独立 user-data-dir。启动 PID 只是候选，仍需刷新并选择真实音频会话。首次使用或来源变化时，建议主动做一次 10 秒试录。" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="录音健康" Style="{StaticResource SectionTitle}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="远端 / 应用" VerticalAlignment="Center"/><ProgressBar x:Name="RemoteLevel" Grid.Column="1" Height="8" Maximum="1"/><TextBlock x:Name="RemoteHealth" Grid.Column="2" Margin="16,0,0,0" Text="尚未采集" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="独立麦克风" VerticalAlignment="Center" Margin="0,16,0,0"/><ProgressBar x:Name="MicLevel" Grid.Row="1" Grid.Column="1" Height="8" Maximum="1" Margin="0,16,0,0"/><TextBlock x:Name="MicHealth" Grid.Row="1" Grid.Column="2" Margin="16,16,0,0" Text="关闭 · 不采集" FontSize="12"/>
                  </Grid>
                  <TextBlock x:Name="ConnectionText" Margin="0,18,0,5" Text="捕获连接：未启动" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="StorageText" Text="保存状态：尚未创建本次录音" Style="{StaticResource MutedText}"/>
                  <WrapPanel x:Name="TrialPlaybackPanel" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="TrialPlaybackButton" Content="试听本次 10 秒试录" Click="Playback_Click"/><Button Content="停止试听" Click="StopPlayback_Click" IsEnabled="{Binding IsEnabled, ElementName=StopPlaybackButton}"/></WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

        </TabItem>
        <TabItem Header="会议库">
          <Grid Margin="22,20,22,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock x:Name="SelectedMeetingText" Text="选择一场会议" FontSize="24" FontWeight="SemiBold" MaxHeight="64" TextTrimming="CharacterEllipsis"/><TextBlock Text="左侧按日期选择历史会议；原始录音始终独立保存。" Margin="0,7,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=MeetingTabs}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
            <TabControl x:Name="MeetingTabs" Grid.Row="1" Padding="0" SelectionChanged="MeetingTabs_SelectionChanged" Background="Transparent">
              <TabItem Header="会议基本信息">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20"><StackPanel>
                  <StackPanel x:Name="RecoveryPanel">
                    <TextBlock Text="会议资料" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="MeetingMetadataText" Text="点击左侧会议库读取列表。也可以导入已有录音，或开始一场新会议。" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="标题" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FiledTitleBox"/>
                    <TextBlock Text="项目" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FiledProjectBox" Text="未分类"/>
                    <WrapPanel Margin="0,16,0,12"><Button x:Name="FileMeetingButton" Content="保存归档信息" Click="FileMeeting_Click" IsEnabled="False"/><Button Content="打开原件目录" Click="OpenRecordingFolder_Click"/></WrapPanel>
                    <Expander Header="检查与恢复原件"><StackPanel Margin="0,12,0,0">
                      <TextBlock Text="恢复创建新副本，不覆盖原件。只包含可验证的数据，不代表缺失的录音已经找回。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                      <WrapPanel><Button x:Name="InspectRecoveryButton" Content="检查所选录音" Click="InspectRecovery_Click" IsEnabled="False"/><Button x:Name="RecoverButton" Content="创建恢复副本" Click="Recover_Click" IsEnabled="False"/></WrapPanel>
                    </StackPanel></Expander>
                  </StackPanel>
                  <TextBox x:Name="RecoveryStatus" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="180" Margin="0,20,0,0" Text="尚未读取任何历史录音。"/>
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem Header="导出音频">

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="一份完整、可带走的声音" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="从独立原轨生成真正的混音，再按接收服务的大小要求导出。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="当前会议" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Text, ElementName=SelectedMeetingText}" FontWeight="Medium" Margin="0,0,0,14"/>
              <WrapPanel><Button Content="选择会议" Tag="1" Click="Navigate_Click"/><Button x:Name="RetryMixButton" Content="生成 / 重试完整混音" Click="RetryMix_Click" IsEnabled="False"/><Button x:Name="CancelExportButton" Content="取消混音 / 导出" Click="CancelExport_Click" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="完整时间轴保留暂停与缺口；导出任务独立运行，不阻挡下一场录音。" Style="{StaticResource MutedText}" FontSize="11"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="导出副本" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="音频格式" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
              <ComboBox x:Name="ExportFormatBox" HorizontalAlignment="Left" Width="330" SelectedIndex="0" AutomationProperties.Name="导出音频格式"><ComboBoxItem Content="M4A · 压缩音频"/><ComboBoxItem Content="WAV · 无损音频"/><ComboBoxItem Content="MP3 · 压缩音频"/></ComboBox>
              <Expander Header="分段与大小设置" IsExpanded="False"><StackPanel Margin="0,12,0,4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0"><TextBlock Text="每片最多字节" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxBytesBox" Text="20000000"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="每片最多秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxSecondsBox" Text="1800"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="相邻片重叠秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OverlapBox" Text="5"/></StackPanel>
                </Grid>
                <TextBlock Text="默认预算为 20 MB / 30 分钟，重叠 5 秒；请按接收服务要求调整。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel></Expander>
              <CheckBox x:Name="IncludeManifestBox" Margin="0,15,0,15"><TextBlock Text="另附分段时间映射清单（文件名、哈希与时间）"/></CheckBox>
              <WrapPanel><Button x:Name="ExportButton" Content="导出供转写" Click="Export_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button x:Name="OpenExportButton" Content="打开导出目录" Click="OpenExport_Click" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="只导出所选混音副本。不附原始麦克风轨、浏览器资料或诊断日志；上传由你自行操作。" Style="{StaticResource MutedText}" FontSize="11"/>
            </StackPanel></Border>
            <TextBlock Text="处理结果" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="ExportStatus" IsReadOnly="True" TextWrapping="Wrap" MinHeight="125" MaxHeight="230" VerticalScrollBarVisibility="Auto" Text="录音保存后会自动生成完整混音。也可以在会议库选择历史录音后重试。"/>
          </StackPanel></ScrollViewer>

              </TabItem>
              <TabItem Header="回听">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="185"><StackPanel Margin="20,12,20,8">
                    <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="读取字幕" Click="RefreshReplay_Click"/><Button x:Name="ReplayExportSubtitlesButton" Content="导出字幕…" Click="ExportReplaySubtitles_Click" ToolTip="导出当前回听版本的完整字幕（SRT / VTT）"/></WrapPanel><ComboBox x:Name="ReplayRevisionBox" DisplayMemberPath="Label" SelectionChanged="ReplayRevision_Changed" AutomationProperties.Name="回听字幕版本"/></DockPanel>
                    <TextBlock x:Name="ReplayStatusText" Text="先选择会议；尚无字幕也能播放完整录音。" Style="{StaticResource MutedText}" FontSize="11"/>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="CurrentSubtitleText" Text="播放时在这里显示当前字幕" FontSize="17" MinHeight="26"/></Border>
                  </StackPanel></ScrollViewer>
                  <ListBox x:Name="ReplaySegmentsBox" Grid.Row="1" Margin="20,0,20,16" BorderThickness="0" PreviewKeyDown="ReplaySegment_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="点击字幕跳转音频">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,5"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ReplaySegment_Click"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Segment.Text}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <Border x:Name="ReplayPlayerBar" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="ReplayPositionSlider" Minimum="0" Maximum="1" ValueChanged="ReplayPosition_Changed" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="回听进度秒"/><TextBlock x:Name="ReplayTimeText" Grid.Column="1" Text="00:00:00 / 00:00:00" Margin="14,0,0,0" FontSize="11" VerticalAlignment="Center"/></Grid>
                      <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="PlaybackButton" Click="Playback_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Width="44" Padding="12,9" ToolTip="从头播放完整录音" AutomationProperties.Name="从头播放完整录音"><Path Data="M 2 0 L 15 8 L 2 16 Z" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                        <Button x:Name="PausePlaybackButton" Click="PausePlayback_Click" Width="44" Padding="12,9" ToolTip="暂停回放" AutomationProperties.Name="暂停回放"><Path x:Name="PauseReplayIcon" Data="M 1 0 H 6 V 16 H 1 Z M 10 0 H 15 V 16 H 10 Z" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                        <Button x:Name="StopPlaybackButton" Click="StopPlayback_Click" Width="44" Padding="12,9" ToolTip="停止回放" AutomationProperties.Name="停止回放"><Path Data="M 0 0 H 14 V 14 H 0 Z" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                        <ComboBox x:Name="PlaybackSpeedBox" Width="90" Margin="4,0,14,6" SelectedIndex="2" SelectionChanged="PlaybackSpeed_Changed" ToolTip="播放倍速" AutomationProperties.Name="播放倍速">
                          <ComboBoxItem Content="0.5x" Tag="0.5"/><ComboBoxItem Content="0.75x" Tag="0.75"/><ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="1.25x" Tag="1.25"/><ComboBoxItem Content="1.5x" Tag="1.5"/><ComboBoxItem Content="2x" Tag="2"/>
                        </ComboBox>
                        <Button Content="生成 / 重试混音" Click="RetryMix_Click"/><Button Content="添加字幕" Tag="3" Click="Navigate_Click"/>
                      </WrapPanel>
                      <TextBlock Text="录音期间（包括暂停与保存收尾）禁用回放。字幕时间为近似值，可单击或按 Enter 定位。" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="转写与搜索">

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="让讨论可以被找回" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="导入已有文本，或使用本地工具进行会后转写。录音不依赖模型。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <ContentControl x:Name="TranscriptionContent" HorizontalContentAlignment="Stretch"/>
          </StackPanel></ScrollViewer>

              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>
        <TabItem Header="诊断与设置">

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,24,26,12"><StackPanel>
            <TextBlock Text="状态清楚，原件可追溯" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="查看预检结果与环境信息，选择本地保存位置。" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Button Content="切换明暗主题" Click="ToggleTheme_Click" HorizontalAlignment="Left"/><TextBlock Text="保存位置" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="DataRootText" Margin="0,0,0,14" FontFamily="Consolas"/>
              <Button x:Name="DataRootButton" Content="选择数据目录" Click="DataRoot_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="原轨、浏览器资料和导出分别存放于此目录内。最长单场录音为 8 小时。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="环境与验证范围" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="EnvironmentText" Style="{StaticResource MutedText}"/>
              <TextBlock Text="部分平台、双设备长期同步及干净 Windows 验收尚未完成。首次使用或更换来源后，请先做可控试录。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="最近诊断信息" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" MaxHeight="380" Text="尚未采集。请选择本次音频来源，预检后主动开始录音。"/>
          </StackPanel></ScrollViewer>

        </TabItem>
      </TabControl>
<Border x:Name="RecordingBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,12,18,12">
        <StackPanel>
          <WrapPanel>
            <Button x:Name="StartButton" Content="开始录音" Click="Start_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="停止并保存" Click="Stop_Click" IsEnabled="False" Style="{StaticResource StopButtonStyle}"/>
            <Button x:Name="MicControlButton" Content="开启 mic" Click="MicControl_Click" IsEnabled="False"/>
            <Button x:Name="BookmarkButton" Content="标记此刻" Click="Bookmark_Click" IsEnabled="False"/>
            <Button x:Name="PreflightButton" Content="预检" Click="Preflight_Click" ToolTip="静态检查，不采集音频"/>
            <Button x:Name="TrialButton" Content="10 秒试录" Click="Trial_Click"/>
          </WrapPanel>
          <DockPanel Margin="2,4,0,0">
            <Button DockPanel.Dock="Right" Content="查看详情" Tag="4" Click="Navigate_Click" FontSize="11" Padding="8,3" MinHeight="24" Margin="14,0,0,0"/>
            <TextBlock Text="{Binding Text, ElementName=StatusBox}" Foreground="{DynamicResource MutedBrush}" FontSize="11" MaxHeight="35" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
