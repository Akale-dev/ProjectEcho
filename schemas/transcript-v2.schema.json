{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectEcho Transcript v2 — immutable local revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "isSynthetic", "meetingId", "revisionId", "parentRevisionId", "provider", "modelName", "importedAt", "meetingDurationMs", "inputExportId", "inputPartId", "sourceMixSha256", "mappingSampleRate", "sourceTimeMapping", "originalFile", "originalSha256", "reviewNote", "segments", "warnings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "isSynthetic": { "type": "boolean" },
    "meetingId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revisionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "parentRevisionId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
    "modelName": { "type": ["string", "null"], "maxLength": 200 },
    "importedAt": { "type": "string", "format": "date-time" },
    "meetingDurationMs": { "type": "integer", "minimum": 1, "maximum": 604800000 },
    "inputExportId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "inputPartId": { "type": ["string", "null"] },
    "sourceMixSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "mappingSampleRate": { "type": ["integer", "null"], "minimum": 8000, "maximum": 192000 },
    "sourceTimeMapping": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fileStartFrame", "sourceStartFrame", "frameCount"],
        "properties": {
          "fileStartFrame": { "type": "integer", "minimum": 0 },
          "sourceStartFrame": { "type": "integer", "minimum": 0 },
          "frameCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "originalFile": { "type": "string", "pattern": "^transcripts/original/[0-9a-f]{32}/original\\.(txt|md|srt|vtt|json)$" },
    "originalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewNote": { "type": ["string", "null"], "maxLength": 10000 },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 50000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segmentId", "startMs", "endMs", "speakerLabel", "sourceKind", "text", "timestampQuality"],
        "properties": {
          "segmentId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "startMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 604800000 },
          "endMs": { "type": ["integer", "null"], "minimum": 1, "maximum": 604800000 },
          "speakerLabel": { "type": ["string", "null"], "maxLength": 200 },
          "sourceKind": { "enum": ["remote", "microphone", "mixed", "unknown"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "timestampQuality": { "enum": ["verified", "approximate", "untimed"] }
        },
        "allOf": [{
          "if": { "properties": { "timestampQuality": { "const": "untimed" } } },
          "then": { "properties": { "startMs": { "type": "null" }, "endMs": { "type": "null" } } },
          "else": { "properties": { "startMs": { "type": "integer" }, "endMs": { "type": "integer" } } }
        }]
      }
    },
    "warnings": { "type": "array", "maxItems": 10000, "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "inputExportId": { "type": "null" } } },
    "then": { "properties": { "inputPartId": { "type": "null" }, "sourceMixSha256": { "type": "null" }, "mappingSampleRate": { "type": "null" }, "sourceTimeMapping": { "maxItems": 0 } } },
    "else": { "properties": { "inputPartId": { "type": "string" }, "sourceMixSha256": { "type": "string" }, "mappingSampleRate": { "type": "integer" }, "sourceTimeMapping": { "minItems": 1 } } }
  }]
}
